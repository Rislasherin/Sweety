PORT=3000
NODE_ENV=development

# PostgreSQL connection string format:
# - Local native PostgreSQL (host port 5432): postgresql://username:password@localhost:5432/sweety_db?schema=public
# - Docker-mapped PostgreSQL (host port 5433): postgresql://username:password@localhost:5433/sweety_db?schema=public
# - Docker internal network access: postgresql://username:password@postgres:5432/sweety_db?schema=public
DATABASE_URL="postgresql://username:password@localhost:5432/sweety_db?schema=public"

# JWT configuration
JWT_SECRET="your_secure_random_jwt_secret_at_least_32_characters"
JWT_EXPIRATION="1d"
JWT_ISSUER="sweety-api"
JWT_AUDIENCE="sweety-client"

# CORS configuration (comma-separated origins)
CORS_ORIGIN="http://localhost:3001,http://127.0.0.1:3001,http://localhost:5173,http://127.0.0.1:5173"

# Logging configuration (trace | debug | info | warn | error | fatal)
LOG_LEVEL="info"
